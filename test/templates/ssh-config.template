Host ${LIBVIRT_HOST}
    HostName ${LIBVIRT_HOST}
    ConnectTimeout 10
    StrictHostKeyChecking no
    User ${LIBVIRT_USER}

Host ${DOMAIN_NAME}
    HostName ${DOMAIN_STATIC_ADDRESS%/*}
    ConnectTimeout 10
    ProxyCommand ssh -o ConnectTimeout=10 -W %h:%p ${LIBVIRT_HOST}
    StrictHostKeyChecking no
    User ${DOMAIN_USER}
